n=top;fontSize=28;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="722.5000524934384" y="448.0" width="2.0" height="34.0" /></mxCell><mxCell id="21" value="⌄" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#AD7E37;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=29.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="709.5000524934384" y="460.0" width="28.0" height="40.0" /></mxCell><mxCell id="22" value="调用并收回结果" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#64768A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=23.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="738.5000524934384" y="450.0" width="230.0" height="37.0" /></mxCell><mxCell id="23" value="它把“调用一次”变成有输入、有过程、有停止条件、可以追查的一次运行。" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80.0" y="622.0" width="1280.0" height="48.0" /></mxCell></root></mxGraphModel></diagram><diagram name="05 把 Harness 打开：一次运行经过哪些环节？"><mxGraphModel page="1" pageWidth="1440" pageHeight="810"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="01 认识 Harness：把一次运行组织起来" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#64768A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=22.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80.0" y="40.0" width="1280.0" height="36.0" /></mxCell><mxCell id="3" value="把 Harness 打开：一次运行经过哪些环节？" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=42.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80.0" y="103.0" width="1280.0" height="98.0" /></mxCell><mxCell id="4" value="05" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#64768A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=22.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80.0" y="744.0" width="55.0" height="30.0" /></mxCell><mxCell id="5" value="这是职责示意。具体实现可以很小，也可以拆成多个服务。" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#64768A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=22.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80.0" y="671.0" width="1280.0" height="58.0" /></mxCell><mxCell id="6" value="" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=#E9F0F5;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80.0" y="253.0" width="365.0" height="119.0" /></mxCell><mxCell id="7" value="1 接收任务&#10;输入与目标" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="98.0" y="270.0" width="329.0" height="94.0" /></mxCell><mxCell id="8" value="" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=#E9F0F5;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="538.0" y="253.0" width="365.0" height="119.0" /></mxCell><mxCell id="9" value="2 准备环境&#10;目录、数据、权限" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="556.0" y="270.0" width="329.0" height="94.0" /></mxCell><mxCell id="10" value="" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=#E9F0F5;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="995.0" y="253.0" width="365.0" height="119.0" /></mxCell><mxCell id="11" value="3 调用执行对象&#10;模型、工具或检查" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1013.0" y="270.0" width="329.0" height="94.0" /></mxCell><mxCell id="12" value="" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=#E9F0F5;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="995.0" y="481.0" width="365.0" height="123.0" /></mxCell><mxCell id="13" value="4 读取实际结果&#10;返回值、错误、耗时" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1013.0" y="498.0" width="329.0" height="98.0" /></mxCell><mxCell id="14" value="" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=#E9F0F5;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80.0" y="481.0" width="823.0" height="123.0" /></mxCell><mxCell id="15" value="5 按规则结束&#10;继续、停止或交给人" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="98.0" y="498.0" width="787.0" height="98.0" /></mxCell><mxCell id="16" value="" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=#AD7E37;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="445.0" y="312.5000524934383" width="79.0" height="2.0" /></mxCell><mxCell id="17" value="›" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#AD7E37;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=34.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="519.0" y="289.5000524934383" width="26.0" height="48.0" /></mxCell><mxCell id="18" value="" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=#AD7E37;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="903.0" y="312.5000524934383" width="78.0" height="2.0" /></mxCell><mxCell id="19" value="›" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#AD7E37;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=34.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="976.0" y="289.5000524934383" width="26.0" height="48.0" /></mxCell><mxCell id="20" value="" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=#AD7E37;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1177.5000524934383" y="372.0" width="2.0" height="54.50005249343832" /></mxCell><mxCell id="21" value="" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=#AD7E37;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1177.5000524934383" y="426.5000524934383" width="2.0" height="2.0" /></mxCell><mxCell id="22" value="" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=#AD7E37;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1177.5000524934383" y="426.5000524934383" width="2.0" height="42.50005249343832" /></mxCell><mxCell id="23" value="⌄" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#AD7E37;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=29.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1164.5000524934383" y="447.0" width="28.0" height="40.0" /></mxCell><mxCell id="24" value="" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=#AD7E37;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="918.0" y="542.0" width="76.0" height="2.0" /></mxCell><mxCell id="25" value="‹" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#AD7E37;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=34.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="903.0" y="519.0" width="28.0" height="48.0" /></mxCell><mxCell id="26" value="日志与报告贯穿各环节，保留这次运行做了什么以及为什么停止。" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80.0" y="627.0" width="1275.0" height="45.0" /></mxCell></root></mxGraphModel></diagram><diagram name="06 模型、Eval 与 Harness 的分工"><mxGraphModel page="1" pageWidth="1440" pageHeight="810"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="01 认识 Harness：把一次运行组织起来" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#64768A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=22.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80.0" y="40.0" width="1280.0" height="36.0" /></mxCell><mxCell id="3" value="模型、Eval 与 Harness 的分工" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=42.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80.0" y="103.0" width="1280.0" height="98.0" /></mxCell><mxCell id="4" value="06" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#64768A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=22.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80.0" y="744.0" width="55.0" height="30.0" /></mxCell><mxCell id="5" value="模型参与实现时，仍要实际执行检查。模型自述“完成”不会替代 Eval 结果。" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#64768A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=22.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80.0" y="671.0" width="1280.0" height="58.0" /></mxCell><mxCell id="6" value="" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=#E9F0F5;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80.0" y="249.0" width="400.0" height="153.0" /></mxCell><mxCell id="7" value="模型&#10;提出方案、生成修改" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="98.0" y="266.0" width="364.0" height="128.0" /></mxCell><mxCell id="8" value="" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=#E9F0F5;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="520.0" y="249.0" width="400.0" height="153.0" /></mxCell><mxCell id="9" value="工具执行&#10;修改文件、运行程序" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="538.0" y="266.0" width="364.0" height="128.0" /></mxCell><mxCell id="10" value="" 