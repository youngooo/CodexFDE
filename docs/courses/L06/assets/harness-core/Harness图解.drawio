<mxfile host="drawio"><diagram name="04 Harness：围绕执行对象组织一次运行的程序"><mxGraphModel page="1" pageWidth="1440" pageHeight="810"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="01 认识 Harness：把一次运行组织起来" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#64768A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=22.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80.0" y="40.0" width="1280.0" height="36.0" /></mxCell><mxCell id="3" value="Harness：围绕执行对象组织一次运行的程序" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=42.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80.0" y="103.0" width="1280.0" height="98.0" /></mxCell><mxCell id="4" value="04" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#64768A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=22.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80.0" y="744.0" width="55.0" height="30.0" /></mxCell><mxCell id="5" value="本讲用“运行组织与控制机制”理解 Harness。执行对象可以是模型，也可以是一组检查函数。" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#64768A;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=22.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80.0" y="671.0" width="1280.0" height="58.0" /></mxCell><mxCell id="6" value="" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=#E9F0F5;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="80.0" y="270.0" width="330.0" height="132.0" /></mxCell><mxCell id="7" value="输入&#10;任务、数据与规则" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="98.0" y="287.0" width="294.0" height="107.0" /></mxCell><mxCell id="8" value="" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=#E9F0F5;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="495.0" y="270.0" width="455.0" height="132.0" /></mxCell><mxCell id="9" value="Harness&#10;准备、调用、约束、记录" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="513.0" y="287.0" width="419.0" height="107.0" /></mxCell><mxCell id="10" value="" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=#E9F0F5;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1035.0" y="270.0" width="325.0" height="132.0" /></mxCell><mxCell id="11" value="输出&#10;结果、证据与状态" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="1053.0" y="287.0" width="289.0" height="107.0" /></mxCell><mxCell id="12" value="" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=#E9F0F5;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="495.0" y="494.0" width="455.0" height="113.0" /></mxCell><mxCell id="13" value="执行对象&#10;模型＋工具，或检查函数" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=none;fillColor=none;fontColor=#182B41;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;fontSize=28.0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="513.0" y="511.0" width="419.0" height="88.0" /></mxCell><mxCell id="